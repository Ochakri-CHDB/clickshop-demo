# ─── ClickShop Intelligence ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.
# Rotate every credential before any non-local deployment.
# ─────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=ClickShop Intelligence
APP_BASE_URL=http://localhost:4242

# ── LibreChat ────────────────────────────────────────────────────────────
LIBRECHAT_BASE_URL=http://localhost:4243
NEXT_PUBLIC_LIBRECHAT_URL=http://localhost:4243
LIBRECHAT_EMBED_MODE=iframe
LIBRECHAT_SERVICE_EMAIL=agent@clickshop.ai
LIBRECHAT_SERVICE_PASSWORD=your-librechat-service-password

# ── LibreChat Secrets (docker-compose) ──────────────────────────────────
JWT_SECRET=your-jwt-secret-64-hex-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-64-hex-chars
CREDS_KEY=your-creds-key-32-chars
CREDS_IV=your-creds-iv-16-chars

# ── ClickHouse Cloud ─────────────────────────────────────────────────────
CLICKHOUSE_HOST=your-clickhouse-host.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=default

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://user:password@host:5432/dbname
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password

# ── Langfuse ─────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Base64 of "PUBLIC_KEY:SECRET_KEY" — for OTel v4 real-time ingestion
# Generate: echo -n "$LANGFUSE_PUBLIC_KEY:$LANGFUSE_SECRET_KEY" | base64
LANGFUSE_OTEL_AUTH=

# ── ClickHouse Cloud API (org invitations) ────────────────────────────────
CHC_API_KEY_ID=your-clickhouse-cloud-api-key-id
CHC_API_KEY_SECRET=your-clickhouse-cloud-api-key-secret

# ── OpenTelemetry / ClickStack ───────────────────────────────────────────
# Server-side SDKs and scripts send to the local OTel collector, which writes
# natively into the demo ClickHouse service (otel_* tables); the service's
# built-in ClickStack / HyperDX UI reads them. No ingestion key needed.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Browser SDKs (HyperDX RUM) send to the collector through an HTTPS proxy
# (Vercel rewrite /otel/* or Caddy). The apiKey is ignored by the collector.
NEXT_PUBLIC_OTEL_ENDPOINT=http://localhost:4318
NEXT_PUBLIC_HYPERDX_API_KEY=clickshop-local

# ── Auth ─────────────────────────────────────────────────────────────────
AUTH_SECRET=your-auth-secret
NEXTAUTH_URL=http://localhost:4242

# ── Anthropic (used by LibreChat) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── ClickShop MCP – ClickHouse ─────────────────────────────────────────
CLICKHOUSE_MCP_URL=https://mcp.clickhouse.com/sse
CLICKHOUSE_MCP_AUTH_TYPE=bearer
CLICKHOUSE_MCP_TOKEN=your-clickhouse-mcp-token

# ── ClickShop MCP – PostgreSQL ─────────────────────────────────────────
POSTGRES_MCP_URL=https://your-postgres-mcp-endpoint/sse
POSTGRES_MCP_AUTH_TYPE=bearer
POSTGRES_MCP_TOKEN=your-postgres-mcp-token

# LLM provider and local accounts
LLM_PROVIDER=openai-compatible
LLM_MODEL=qwen2.5:7b
OPENAI_BASE_URL=http://localhost:11434/v1
DEMO_PASSWORD=change-me
DEMO_EMAIL_DOMAIN=clickshop.io
ADMIN_EMAIL=
ALLOWED_EMAIL_DOMAIN=

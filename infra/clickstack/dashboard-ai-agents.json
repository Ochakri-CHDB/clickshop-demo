{
  "version": "0.1.0",
  "name": "ClickShop - AI Agents",
  "description": "LibreChat agent activity: agent runs, chat latency, MCP tool latency (ClickHouse, Postgres, RAG), Langfuse ingestion. Import into ClickStack and map tiles to the Traces source.",
  "tiles": [
    {
      "id": "agents-runs-count",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 5,
      "config": {
        "name": "Agent runs (range)",
        "source": "Traces",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "ServiceName:\"clickshop-librechat\" AND SpanName:\"POST /api/ask/*\"",
        "whereLanguage": "lucene",
        "numberFormat": { "output": "number", "mantissa": 0 }
      }
    },
    {
      "id": "agents-chat-p95",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 5,
      "config": {
        "name": "Chat API p95 (ms)",
        "source": "Traces",
        "displayType": "number",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Duration/1e6"
          }
        ],
        "where": "ServiceName:\"clickshop-api\" AND SpanName:\"HTTP POST /api/chat\"",
        "whereLanguage": "lucene",
        "numberFormat": { "output": "number", "mantissa": 0, "unit": "ms" },
        "color": "chart-success",
        "colorRules": [
          { "operator": "between", "value": [5000, 15000], "color": "chart-warning", "label": "slow" },
          { "operator": "gt", "value": 15000, "color": "chart-error", "label": "very slow" }
        ]
      }
    },
    {
      "id": "agents-pipeline-errors",
      "x": 12,
      "y": 0,
      "w": 6,
      "h": 5,
      "config": {
        "name": "Agent pipeline errors",
        "source": "Traces",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "StatusCode:\"Error\"",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "ServiceName:\"clickshop-librechat\"",
        "whereLanguage": "lucene",
        "numberFormat": { "output": "number", "mantissa": 0 },
        "color": "chart-success",
        "colorRules": [
          { "operator": "gte", "value": 1, "color": "chart-warning" },
          { "operator": "gte", "value": 20, "color": "chart-error" }
        ]
      }
    },
    {
      "id": "agents-rag-count",
      "x": 18,
      "y": 0,
      "w": 6,
      "h": 5,
      "config": {
        "name": "RAG retrievals (range)",
        "source": "Traces",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "SpanName:\"rag.retrieve\"",
        "whereLanguage": "lucene",
        "numberFormat": { "output": "number", "mantissa": 0 }
      }
    },
    {
      "id": "agents-runs-by-agent",
      "x": 0,
      "y": 5,
      "w": 12,
      "h": 8,
      "config": {
        "name": "Agent runs by persona",
        "source": "Traces",
        "displayType": "stacked_bar",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "ServiceName:\"clickshop-librechat\" AND SpanName:\"POST /api/ask/*\"",
        "whereLanguage": "lucene",
        "groupBy": "SpanName",
        "granularity": "auto"
      }
    },
    {
      "id": "agents-tool-latency",
      "x": 12,
      "y": 5,
      "w": 12,
      "h": 8,
      "config": {
        "name": "MCP / tool latency p95 (ms)",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Duration/1e6"
          }
        ],
        "where": "SpanName:(\"clickhouse.query\" OR \"postgresql.query\" OR \"rag.retrieve\" OR \"vectordb.similarity_search\" OR \"meilisearch.search\")",
        "whereLanguage": "lucene",
        "groupBy": "SpanName",
        "granularity": "auto",
        "fitYAxisToData": true
      }
    },
    {
      "id": "agents-langfuse-ingest",
      "x": 0,
      "y": 13,
      "w": 12,
      "h": 8,
      "config": {
        "name": "Langfuse trace ingestion",
        "source": "Traces",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "",
            "alias": "langfuse.ingest"
          }
        ],
        "where": "SpanName:\"langfuse.ingest\"",
        "whereLanguage": "lucene",
        "granularity": "auto"
      }
    },
    {
      "id": "agents-slowest-ops",
      "x": 12,
      "y": 13,
      "w": 12,
      "h": 8,
      "config": {
        "name": "Slowest agent operations (p95 ms)",
        "source": "Traces",
        "displayType": "table",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "",
            "alias": "calls"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Duration/1e6",
            "alias": "p95_ms"
          }
        ],
        "where": "ServiceName:\"clickshop-librechat\"",
        "whereLanguage": "lucene",
        "groupBy": "SpanName",
        "limit": { "limit": 15 }
      }
    }
  ]
}

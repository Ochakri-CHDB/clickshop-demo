{
  "version": "0.1.0",
  "name": "ClickShop - Platform & Business Flow",
  "description": "Log health per service, payment webhook throughput, telemetry ingestion freshness, and pod CPU/memory. Import into ClickStack: map log tiles to the Logs source, metric tiles to the Metrics source.",
  "tiles": [
    {
      "id": "plat-payment-webhooks",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 5,
      "config": {
        "name": "Payment webhooks (range)",
        "source": "Logs",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "\"Payment webhook received\"",
        "whereLanguage": "lucene",
        "numberFormat": { "output": "number", "mantissa": 0 }
      }
    },
    {
      "id": "plat-error-logs",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 5,
      "config": {
        "name": "ERROR logs (range)",
        "source": "Logs",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "SeverityText:\"ERROR\"",
        "whereLanguage": "lucene",
        "numberFormat": { "output": "number", "mantissa": 0 },
        "color": "chart-success",
        "colorRules": [
          { "operator": "gte", "value": 10, "color": "chart-warning" },
          { "operator": "gte", "value": 100, "color": "chart-error" }
        ]
      }
    },
    {
      "id": "plat-log-volume-number",
      "x": 12,
      "y": 0,
      "w": 6,
      "h": 5,
      "config": {
        "name": "Total log volume (range)",
        "source": "Logs",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "numberFormat": { "output": "number", "mantissa": 0, "thousandSeparated": true }
      }
    },
    {
      "id": "plat-services-reporting",
      "x": 18,
      "y": 0,
      "w": 6,
      "h": 5,
      "config": {
        "name": "Services reporting logs",
        "source": "Logs",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count_distinct",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "ServiceName"
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "numberFormat": { "output": "number", "mantissa": 0 },
        "color": "chart-success",
        "colorRules": [
          { "operator": "lt", "value": 3, "color": "chart-error", "label": "ingestion gap" }
        ]
      }
    },
    {
      "id": "plat-payment-throughput",
      "x": 0,
      "y": 5,
      "w": 12,
      "h": 8,
      "config": {
        "name": "Payment webhook throughput",
        "source": "Logs",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "",
            "alias": "payment webhooks"
          }
        ],
        "where": "\"Payment webhook received\"",
        "whereLanguage": "lucene",
        "granularity": "auto"
      }
    },
    {
      "id": "plat-log-volume-by-service",
      "x": 12,
      "y": 5,
      "w": 12,
      "h": 8,
      "config": {
        "name": "Log volume by service (ingestion health)",
        "source": "Logs",
        "displayType": "stacked_bar",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "groupBy": "ServiceName",
        "granularity": "auto"
      }
    },
    {
      "id": "plat-errors-warnings",
      "x": 0,
      "y": 13,
      "w": 12,
      "h": 8,
      "config": {
        "name": "Errors and warnings by service",
        "source": "Logs",
        "displayType": "line",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "SeverityText:\"ERROR\"",
            "aggConditionLanguage": "lucene",
            "valueExpression": "",
            "alias": "errors"
          },
          {
            "aggFn": "count",
            "aggCondition": "SeverityText:\"WARN\"",
            "aggConditionLanguage": "lucene",
            "valueExpression": "",
            "alias": "warnings"
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "granularity": "auto"
      }
    },
    {
      "id": "plat-pod-cpu",
      "x": 12,
      "y": 13,
      "w": 12,
      "h": 8,
      "config": {
        "name": "Pod CPU utilization",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "avg",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Value",
            "metricName": "k8s.pod.cpu.utilization",
            "metricType": "gauge"
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "groupBy": "k8s.pod.name",
        "granularity": "auto",
        "numberFormat": { "output": "percent", "mantissa": 1 },
        "fitYAxisToData": true
      }
    },
    {
      "id": "plat-pod-memory",
      "x": 0,
      "y": 21,
      "w": 12,
      "h": 8,
      "config": {
        "name": "Pod memory utilization",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "avg",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Value",
            "metricName": "k8s.pod.memory.utilization",
            "metricType": "gauge"
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "groupBy": "k8s.pod.name",
        "granularity": "auto",
        "numberFormat": { "output": "percent", "mantissa": 1 },
        "fitYAxisToData": true
      }
    },
    {
      "id": "plat-recent-error-logs",
      "x": 12,
      "y": 21,
      "w": 12,
      "h": 8,
      "config": {
        "name": "Recent ERROR logs",
        "source": "Logs",
        "displayType": "search",
        "select": "Timestamp, ServiceName, Body",
        "where": "SeverityText:\"ERROR\"",
        "whereLanguage": "lucene"
      }
    }
  ]
}
